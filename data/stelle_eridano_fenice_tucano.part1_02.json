
 "fenice": [
  {
   "id": "ankaa",
   "nome": "Ankaa",
   "bayer": "\u03b1 Phoenicis (\u03b1 Phe; HD 2261, HIP 2081)",
   "origine_nome": "Dall'arabo \u0627\u0644\u0639\u0646\u0642\u0627\u0621 (al-\u02bfanq\u0101\u02be), \u00abla fenice\u00bb: il nome della costellazione intera, l'uccello che rinasce dalle proprie ceneri. Nomi tradizionali: Nair al Zaurak (\u00abil luminoso della barca\u00bb), Cymbae, Lucida Cymbae. Nome ufficiale IAU.",
   "magnitudine": "2,38 (it.wiki tabella 2,40)",
   "spettro": "K0.5 IIIb (gigante arancione); 0,96 M\u2609, raggio 13,39 R\u2609, 83 L\u2609, Teff 4770 K, metallicit\u00e0 [Fe/H] \u22120,73",
   "distanza_al": 82,
   "curiosita": "\u00c8 il vertice meridionale di un grande triangolo con Fomalhaut e Deneb Kaitos (Balena). Binaria spettroscopica con periodo di 3848,8 giorni (circa 10,5 anni) ed eccentricit\u00e0 0,34. Nella tradizione cinese apre l'asterismo Shu\u01d0 W\u011bi (\u6c34\u59d4, \u00abl'acqua che scorre torta\u00bb) insieme ad Achernar, la foce dell'Eridano: le due costellazioni si toccano anche in cielo. Distanza: 82 \u00b1 1 anni luce (Hipparcos van Leeuwen 2007); la tabella italiana d\u00e0 77.",
   "fonte_url": "https://en.wikipedia.org/wiki/Alpha_Phoenicis"
  },
  {
   "id": "beta_phoenicis",
   "nome": "Beta Phoenicis",
   "bayer": "\u03b2 Phoenicis (\u03b2 Phe; HD 6595, HIP 5165)",
   "origine_nome": "Designazione di Bayer; nessun nome proprio.",
   "magnitudine": "3,30 (it.wiki tabella 3,32)",
   "spettro": "Binaria di due giganti G8 III quasi identiche (it.wiki \u00abG8IIIvar\u00bb)",
   "distanza_al": 182,
   "curiosita": "Due giganti gemelle di luminosit\u00e0 simile separate da circa un secondo d'arco, su un'orbita di 170,7 anni piuttosto eccentrica. La presenza di due stelle vicine confonde le missioni astrometriche, che assumono la stella singola: per questo la parallasse \u00e8 rimasta a lungo incerta. La distanza qui scelta (182 \u00b1 5 anni luce) \u00e8 la rianalisi Hipparcos che tiene conto della binarit\u00e0; la tabella it.wiki riporta 198 al dalla misura precedente. Da cieli europei la Fenice resta bassa sull'orizzonte, ma la coppia \u00e8 risolvibile con un telescopio di medie dimensioni.",
   "fonte_url": "https://en.wikipedia.org/wiki/Beta_Phoenicis"
  },
  {
   "id": "gamma_phoenicis",
   "nome": "Gamma Phoenicis",
   "bayer": "\u03b3 Phoenicis (\u03b3 Phe; HD 9053, HIP 6867)",
   "origine_nome": "Designazione di Bayer; nessun nome proprio.",
   "magnitudine": "variabile 3,39\u20133,49 (irregolare lenta sospetta)",
   "spettro": "M0 III (gigante rossa, Keenan & McNeil 1989; la tabella it.wiki riporta K5 II-III)",
   "distanza_al": 234,
   "curiosita": "Binaria spettroscopica con orbita di 194,1 giorni (le variazioni di 97,5 giorni dell'Hipparcos erano mezza orbita): le variazioni di luminosit\u00e0 sembrano eclissi, ma l'alta inclinazione suggerisce due stelle ellipsoidali. La primaria M0III mostra un'attivit\u00e0 coronale troppo intensa per una gigante cos\u00ec fredda: forse viene dalla secondaria, che accresce materiale dalla compagna. Uno dei rari casi di binaria spettroscopica con gigante M. Distanza: 233,6 anni luce (71,63 pc, Hipparcos).",
   "fonte_url": "https://en.wikipedia.org/wiki/Gamma_Phoenicis"
  },
